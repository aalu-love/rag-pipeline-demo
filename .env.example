# Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text

# Qdrant server. If it's unreachable, an embedded on-disk store at QDRANT_PATH is used instead.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
COLLECTION=rag_docs

# Chunking / retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=6
FETCH_K=10
MULTI_QUERY=3
